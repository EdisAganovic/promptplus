{
  "name": "promptplus",
  "version": "0.6.0",
  "private": true,
  "description": "PromptPlus desktop prompt replacer",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.promptplus.desktop",
    "productName": "PromptPlus",
    "electronLanguages": ["en-US"],
    "directories": { "output": "dist-electron" },
    "files": ["electron/**/*", "package.json", "icon.ico"],
    "extraResources": [
      { "from": "dist/PromptPlusBackend", "to": "backend", "filter": ["**/*"] },
      { "from": "electron/tray.ico", "to": "tray.ico" },
      { "from": "icon.ico", "to": "icon.ico" }
    ],
    "win": { "target": "nsis", "icon": "electron/tray.ico", "signExecutable": false },
    "nsis": {
      "artifactName": "PromptPlus-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/tray.ico",
      "uninstallerIcon": "electron/tray.ico",
      "installerHeaderIcon": "electron/tray.ico",
      "createDesktopShortcut": false,
      "shortcutName": "PromptPlus",
      "uninstallDisplayName": "PromptPlus ${version}"
    }
  }
}
